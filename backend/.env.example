# QUITIN backend environment
# Copy to `.env` and fill in the values you need.
# Never commit the real `.env` file - it contains secrets.

# One PostgreSQL instance is expected (native Windows service or Docker),
# listening on 127.0.0.1:5432 with a database named `quitin`.
# The development manager checks this before starting anything.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/quitin?schema=public&connection_limit=20"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="quitin_token"
NODE_ENV="development"

FRONTEND_URL="http://localhost:3000"
PORT=4000

# ---- AI assistant (any OpenAI-compatible provider) ----
# Google Gemini example:
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_API_KEY=""
AI_MODEL="gemini-3.5-flash"

# ---- Email (optional) ----
# Configure SMTP or Resend. Without them, emails are logged to the console and
# new accounts are auto-verified in development.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# RESEND_API_KEY=""
MAIL_FROM="QUITIN <no-reply@quitin.local>"

# ---- OAuth (optional) ----
# Callback URLs to register with the providers:
#   http://localhost:4000/api/auth/oauth/google/callback
#   http://localhost:4000/api/auth/oauth/facebook/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""
OAUTH_CALLBACK_BASE="http://localhost:4000"
