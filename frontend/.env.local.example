# URL the Next.js dev server proxies API calls to.
BACKEND_URL="http://localhost:4000"
# Public URL of the backend used for the Socket.IO connection.
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
# Optional: absolute backend origin used for OAuth redirects.
# Leave unset to use http://localhost:4000.
# NEXT_PUBLIC_API_URL="http://localhost:4000"
